{
  "expo": {
    "name": "Lock In AI",
    "slug": "looksmax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lockinai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Lock In AI uses your camera to scan and analyze your facial features, measuring symmetry, jawline definition, and skin clarity to generate your personalized improvement plan.",
        "NSPhotoLibraryUsageDescription": "Lock In AI saves your scan photos to track your progress over time.",
        "NSUserNotificationsUsageDescription": "Lock In AI sends reminders to help you stay consistent with your daily tasks, water intake goals, and weekly face scans."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "com.lockinai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Lock In AI uses your camera to scan and analyze your facial features, measuring symmetry, jawline definition, and skin clarity to generate your personalized improvement plan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#00E5FF"
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "zackhie",
    "privacy": "public",
    "githubUrl": "https://github.com/Zackhie/looksmax",
    "platforms": ["ios", "android"]
  }
}
